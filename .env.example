# Port d'écoute du serveur
PORT=3000

# Clé secrète que les scripts de supervision doivent présenter
# (header: Authorization: Bearer <valeur>) pour pousser des données.
# Générer une valeur forte, ex: openssl rand -hex 32
INGEST_API_KEY=change-me

# Identifiants optionnels pour protéger la consultation du dashboard.
# Laisser vide pour désactiver (si l'accès est déjà restreint par Tailscale).
DASHBOARD_USER=
DASHBOARD_PASS=

# Dossier où la base SQLite est stockée (monter en volume Docker)
DATA_DIR=./data
